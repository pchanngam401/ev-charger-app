# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env.local)

# URL ของ FastAPI backend — Next.js จะ proxy /api/* ไปที่นี่ (ฝั่ง server)
# dev: http://127.0.0.1:8000 · Vercel: https://<ชื่อโปรเจกต์ API>.vercel.app
API_URL=http://127.0.0.1:8000

# (ไม่บังคับ) เซิร์ฟเวอร์คำนวณเส้นทาง OSRM — ค่าเริ่มต้นคือเซิร์ฟเวอร์สาธิตฟรี
# NEXT_PUBLIC_ROUTING_URL=https://router.project-osrm.org

# (ไม่บังคับ) เซิร์ฟเวอร์ค้นหาสถานที่ Photon — ค่าเริ่มต้นคือเซิร์ฟเวอร์สาธารณะของ komoot
# NEXT_PUBLIC_GEOCODER_URL=https://photon.komoot.io
