# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-supabase-anon-key>

# (ไม่บังคับ) โดเมนที่อนุญาตให้เบราว์เซอร์เรียก API ตรง คั่นด้วย ,
# CORS_ORIGINS=https://your-web.vercel.app

# กุญแจลับร่วมกับหน้าเว็บ (ค่าเดียวกับ API_SHARED_SECRET ของโปรเจกต์เว็บ)
# ตั้งแล้ว API จะรับเฉพาะคำขอที่ส่งผ่านหน้าเว็บ — ตั้งที่เว็บก่อนแล้วค่อยตั้งที่ API
# API_SHARED_SECRET=

# (ไม่บังคับ) จำกัดจำนวนคำขอต่อ IP ต่อนาที
# RATE_LIMIT_PER_MIN=120
# RATE_LIMIT_HEAVY_PER_MIN=20

# (ไม่บังคับ) เปิดหน้า /docs บน production
# ENABLE_DOCS=1
